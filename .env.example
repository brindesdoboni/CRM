# Copie este arquivo para .env (só no seu computador) e preencha.
# No Railway, cadastre estas mesmas variáveis em "Variables".

# Endereço do banco PostgreSQL (o Railway preenche sozinho ao ligar o Postgres)
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Chave secreta da sessão: uma frase longa e aleatória (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-frase-bem-longa-e-aleatoria

# Primeiro acesso: cria o usuário Admin se ainda não existir nenhum usuário
ADMIN_NAME=Lucas
ADMIN_EMAIL=
ADMIN_PASSWORD=

# production no Railway; development no seu computador
NODE_ENV=development
PORT=3000
