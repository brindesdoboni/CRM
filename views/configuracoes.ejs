<%- include('partials/topo') %>
<div class="cabecalho">
  <h1>Cadastros e configurações</h1>
  <a class="botao" href="/configuracoes/sdr">SDR automático: perguntas, pontuação e áudios →</a>
</div>
<div class="grade">
  <div class="cartao">
    <h2>Origens dos leads e vendas</h2>
    <p class="sutil pequeno">Desativar tira a origem das listas novas, mas mantém o histórico.</p>
    <table class="tabela">
      <tbody>
      <% origins.forEach(function (o) { %>
        <tr class="<%= o.active ? '' : 'inativo' %>"><td>
          <form method="post" action="/configuracoes/origens/<%= o.id %>" class="em-linha">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="nome" value="<%= o.name %>" required aria-label="Nome da origem">
            <label class="opcao"><input type="checkbox" name="ativa" <%= o.active ? 'checked' : '' %>> ativa</label>
            <button class="botao secundario pequeno" type="submit">Salvar</button>
          </form>
        </td></tr>
      <% }) %>
      </tbody>
    </table>
    <form method="post" action="/configuracoes/origens" class="em-linha">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="nome" placeholder="Nova origem" required aria-label="Nova origem">
      <button class="botao pequeno" type="submit">Adicionar</button>
    </form>
  </div>
  <div class="cartao">
    <h2>Integrações (leads automáticos)</h2>
    <p class="sutil pequeno">Cada ferramenta (formulário do site, ManyChat) recebe uma chave própria e manda os leads direto para o CRM. Telefone repetido não cria lead duplicado: o contato entra no lead em aberto.</p>
    <% if (integrations.length) { %>
    <table class="tabela">
      <thead><tr><th>Nome</th><th>Origem</th><th>Leads</th><th>Último envio</th><th></th></tr></thead>
      <tbody>
      <% integrations.forEach(function (i) { %>
        <tr class="<%= i.active ? '' : 'inativo' %>">
          <td><strong><%= i.name %></strong><br><span class="sutil pequeno"><%= INTEGRATION_CHANNELS[i.channel] %> · chave …<%= i.token_hint %></span></td>
          <td><%= i.origin %></td>
          <td><%= i.leads %></td>
          <td class="nowrap"><%= i.last_used_at ? formatDateTime(i.last_used_at) : '—' %></td>
          <td>
            <form method="post" action="/configuracoes/integracoes/<%= i.id %>/ativa" class="em-linha">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="botao secundario pequeno" type="submit"><%= i.active ? 'Desativar' : 'Ativar' %></button>
            </form>
            <form method="post" action="/configuracoes/integracoes/<%= i.id %>/nova-chave" class="em-linha" data-confirmar="A chave atual vai parar de funcionar. Gerar uma nova?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="botao secundario pequeno" type="submit">Nova chave</button>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% } %>
    <form method="post" action="/configuracoes/integracoes">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="linha">
        <label>Nome <input type="text" name="nome" placeholder="Ex.: Formulário do site" required></label>
        <label>Tipo
          <select name="canal" required>
            <% Object.keys(INTEGRATION_CHANNELS).forEach(function (k) { %><option value="<%= k %>"><%= INTEGRATION_CHANNELS[k] %></option><% }) %>
          </select>
        </label>
        <label>Origem dos leads
          <select name="origem" required>
            <% origins.filter(function (o) { return o.active; }).forEach(function (o) { %><option value="<%= o.id %>"><%= o.name %></option><% }) %>
          </select>
        </label>
      </div>
      <button class="botao pequeno" type="submit">Criar integração</button>
    </form>
  </div>
  <div class="cartao">
    <h2>Dados da empresa (PDF) e frete</h2>
    <p class="sutil pequeno">Aparecem no topo do PDF "Resumo do pedido". O CEP de origem é usado na cotação da SuperFrete.</p>
    <form method="post" action="/configuracoes/empresa">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="linha">
        <label>Nome <input type="text" name="empresa_nome" value="<%= settings.empresa_nome %>"></label>
        <label>CNPJ <input type="text" name="empresa_cnpj" value="<%= settings.empresa_cnpj %>"></label>
      </div>
      <div class="linha">
        <label>Telefone / WhatsApp <input type="text" name="empresa_telefone" value="<%= settings.empresa_telefone %>"></label>
        <label>E-mail <input type="text" name="empresa_email" value="<%= settings.empresa_email %>"></label>
      </div>
      <div class="linha">
        <label>Site <input type="text" name="empresa_site" value="<%= settings.empresa_site %>"></label>
        <label class="curto">CEP de origem do frete <input type="text" name="frete_cep_origem" value="<%= settings.frete_cep_origem %>" inputmode="numeric"></label>
      </div>
      <label>Endereço <input type="text" name="empresa_endereco" value="<%= settings.empresa_endereco %>"></label>
      <button class="botao pequeno" type="submit">Salvar</button>
    </form>
  </div>
  <div class="cartao">
    <h2>Em breve</h2>
    <p class="sutil">Produtos, formas de pagamento, motivos de perda, regras (atacado, prazos, validade), e textos prontos.</p>
  </div>
</div>
<%- include('partials/rodape') %>
