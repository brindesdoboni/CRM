<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · CRM DoBoni</title>
  <link rel="stylesheet" href="/static/estilo.css?v=<%= v %>">
  <link rel="icon" type="image/png" href="/static/favicon.png?v=<%= v %>">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png?v=<%= v %>">
  <meta name="theme-color" content="#74201f">
  <script src="/static/app.js?v=<%= v %>" defer></script>
</head>
<body>
<% if (currentUser) { %>
<header class="topo">
  <a class="marca" href="/"><img src="/static/logo-160.png?v=<%= v %>" alt="">Brindes DoBoni <span>CRM</span></a>
  <nav class="menu">
    <% menu.forEach(function (m) { %>
      <a href="<%= m.path %>" class="<%= path.startsWith(m.path) ? 'ativo' : '' %>"><%= m.label %></a>
    <% }) %>
    <% if (currentUser.role === 'admin') { %>
      <a href="/usuarios" class="<%= path.startsWith('/usuarios') ? 'ativo' : '' %>">Usuários e permissões</a>
    <% } %>
  </nav>
  <div class="conta">
    <a href="/avisos" class="sino <%= unread ? 'tem' : '' %>" title="Avisos" aria-label="Avisos<%= unread ? ' (' + unread + ' novos)' : '' %>">🔔<% if (unread) { %><span class="contador"><%= unread > 99 ? '99+' : unread %></span><% } %></a>
    <a href="/minha-conta" title="Minha conta"><%= currentUser.name %> · <%= ROLE_LABELS[currentUser.role] %></a>
    <form method="post" action="/sair">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="link">Sair</button>
    </form>
  </div>
</header>
<% } %>
<main class="<%= currentUser ? 'conteudo' : 'conteudo centro' %>">
<% flash.forEach(function (m) { %>
  <div class="aviso aviso-<%= m.type %>"><%= m.message %></div>
<% }) %>
