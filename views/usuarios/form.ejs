<%- include('../partials/topo') %>
<p><a href="/usuarios">← Usuários</a></p>
<h1><%= editing ? 'Editar usuário' : 'Novo usuário' %></h1>
<div class="grade">
  <div class="cartao">
    <% if (error) { %><div class="aviso aviso-erro"><%= error %></div><% } %>
    <form method="post" action="<%= editing ? '/usuarios/' + editing.id : '/usuarios' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nome <input type="text" name="nome" value="<%= form.name %>" required></label>
      <label>E-mail (usado para entrar) <input type="email" name="email" value="<%= form.email %>" required></label>
      <% if (!editing) { %>
        <label>Senha inicial (mínimo 8 caracteres) <input type="text" name="senha" required minlength="8" autocomplete="off"></label>
      <% } %>
      <fieldset>
        <legend>Perfil</legend>
        <% ROLES.forEach(function (r) { %>
          <label class="opcao">
            <input type="radio" name="perfil" value="<%= r %>" <%= form.role === r ? 'checked' : '' %> required
                   data-padrao="<%= ROLE_DEFAULT_PERMISSIONS[r].join(',') %>">
            <strong><%= ROLE_LABELS[r] %></strong> <span class="sutil">— <%= ROLE_DESCRIPTIONS[r] %></span>
          </label>
        <% }) %>
      </fieldset>
      <fieldset id="permissoes">
        <legend>O que esta pessoa pode ver</legend>
        <p class="sutil pequeno" data-aviso-admin <%= form.role === 'admin' ? '' : 'hidden' %>>O Admin vê tudo, inclusive "Usuários e permissões".</p>
        <p class="sutil pequeno" data-aviso-outros <%= form.role === 'admin' ? 'hidden' : '' %>>Marque só o que esta pessoa precisa. Ao trocar o perfil, as caixas voltam ao padrão dele; depois você pode ajustar.</p>
        <% PERMISSIONS.forEach(function (p) { var marcado = form.role === 'admin' || form.permissions.indexOf(p.key) !== -1; %>
          <label class="opcao">
            <input type="checkbox" name="permissoes" value="<%= p.key %>" <%= marcado ? 'checked' : '' %> <%= form.role === 'admin' ? 'disabled' : '' %>>
            <span><strong><%= p.label %></strong> <span class="sutil">— <%= p.description %></span></span>
          </label>
        <% }) %>
      </fieldset>
      <% if (editing) { %>
        <label class="opcao"><input type="checkbox" name="ativo" <%= form.active ? 'checked' : '' %>> Usuário ativo (desmarque para bloquear o acesso)</label>
      <% } else { %>
        <input type="hidden" name="ativo" value="on">
      <% } %>
      <button type="submit" class="botao"><%= editing ? 'Salvar' : 'Criar usuário' %></button>
    </form>
  </div>
  <% if (editing) { %>
  <div class="cartao">
    <h2>Redefinir senha</h2>
    <p class="sutil">Use quando a pessoa esquecer a senha. Ela será desconectada de todos os aparelhos.</p>
    <form method="post" action="/usuarios/<%= editing.id %>/senha">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Nova senha (mínimo 8 caracteres) <input type="text" name="senha" required minlength="8" autocomplete="off"></label>
      <button type="submit" class="botao secundario">Redefinir senha</button>
    </form>
  </div>
  <% } %>
</div>
<% if (editing) { %>
<div class="cartao">
  <h2>Histórico</h2>
  <% if (history.length === 0) { %><p class="sutil">Sem registros.</p><% } else { %>
  <table class="tabela">
    <thead><tr><th>Quando</th><th>Quem</th><th>O quê</th></tr></thead>
    <tbody>
    <% history.forEach(function (h) { %>
      <tr><td class="nowrap"><%= formatDateTime(h.created_at) %></td><td><%= h.author || 'Sistema' %></td><td><%= h.description %></td></tr>
    <% }) %>
    </tbody>
  </table>
  <% } %>
</div>
<% } %>
<%- include('../partials/rodape') %>
